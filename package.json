{
	"name": "suica-ui",
	"version": "0.1.0",
	"description": "Suica's React UI components and theme",
	"license": "MIT",
	"keywords": [
		"react",
		"ui",
		"components",
		"component-library",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SuicaLondon/suica-ui.git"
	},
	"homepage": "https://github.com/SuicaLondon/suica-ui#readme",
	"bugs": {
		"url": "https://github.com/SuicaLondon/suica-ui/issues"
	},
	"private": false,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README.md",
		"tailwind.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"style": "./dist/styles.css",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": {
			"types": "./dist/styles-export.d.ts",
			"default": "./dist/styles.css"
		},
		"./tailwind.css": {
			"types": "./dist/styles-export.d.ts",
			"default": "./tailwind.css"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "pnpm clean && vite build && tsc -p tsconfig.build.json",
		"build-storybook": "storybook build",
		"clean": "rm -rf dist storybook-static",
		"format": "prettier --write src .storybook .github scripts test README.md package.json tailwind.css tsconfig*.json *.ts",
		"format:check": "prettier --check src .storybook .github scripts test README.md package.json tailwind.css tsconfig*.json *.ts",
		"lint": "eslint --max-warnings=0 --ext .ts,.tsx src .storybook",
		"lint:fix": "pnpm lint --fix",
		"prepare": "node scripts/prepare.mjs",
		"prepack": "pnpm build",
		"prepublishOnly": "HUSKY=0 pnpm verify",
		"storybook": "storybook dev -p 6006",
		"test": "vitest run",
		"test:package": "pnpm build && node scripts/test-client-boundary.mjs && tsc -p test/package-consumer/tsconfig.json && node scripts/test-tailwind-css.mjs",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:package"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.5.10",
		"@storybook/addon-themes": "10.5.10",
		"@storybook/react-vite": "10.5.10",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "20.19.0",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-prettier": "5.1.3",
		"eslint-plugin-react": "7.33.2",
		"eslint-plugin-storybook": "10.5.10",
		"husky": "9.1.7",
		"jsdom": "26.1.0",
		"lint-staged": "15.5.0",
		"postcss": "8.5.3",
		"prettier": "3.4.2",
		"prettier-plugin-tailwindcss": "0.6.11",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"storybook": "10.5.10",
		"tailwindcss": "4.3.3",
		"typescript": "5.8.2",
		"vite": "7.0.2",
		"vitest": "3.2.4"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix --max-warnings=0 --ignore-pattern '!.storybook'",
			"prettier --write"
		],
		"*.{css,json,md}": "prettier --write"
	},
	"packageManager": "pnpm@10.6.4+sha512.da3d715bfd22a9a105e6e8088cfc7826699332ded60c423b14ec613a185f1602206702ff0fe4c438cb15c979081ce4cb02568e364b15174503a63c7a8e2a5f6c",
	"dependencies": {
		"clsx": "2.1.1",
		"tailwind-merge": "3.6.0"
	}
}
