{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"stripInternal": true
	},
	"include": ["src"],
	"exclude": [
		"src/styles-entry.ts",
		"src/**/*.stories.tsx",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/test"
	]
}
